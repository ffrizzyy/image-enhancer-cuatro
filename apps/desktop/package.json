{
  "name": "@ie/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Electron desktop shell for the local image enhancer",
  "author": "Image Enhancer",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "smoke": "node scripts/build.mjs && electron . --smoke",
    "e2e": "node scripts/build.mjs && node e2e/fullFlow.mjs",
    "provider-tool": "node scripts/build.mjs && electron . --provider-tool",
    "package": "node scripts/build.mjs && electron-builder --dir --win --config electron-builder.yml",
    "dist": "node scripts/build.mjs && electron-builder --win --config electron-builder.yml",
    "package:smoke": "node ../../scripts/package-smoke.mjs",
    "rebuild:native": "electron-rebuild --module-dir .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "//": "Everything below is bundled by esbuild/Vite into dist/, so it is a devDependency and is not shipped. A future native module must go in `dependencies`, be marked external in scripts/build.mjs, and be rebuilt with `pnpm rebuild:native` (see electron-builder.yml).",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@ie/contracts": "workspace:*",
    "@ie/intake": "workspace:*",
    "@ie/presets": "workspace:*",
    "@ie/providers": "workspace:*",
    "@ie/sessions": "workspace:*",
    "@ie/slicer": "workspace:*",
    "@ie/stitcher": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^3.2.0",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@ie/orchestrator": "workspace:*",
    "sharp": "^0.35.5"
  }
}
