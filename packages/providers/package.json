{
  "name": "@ie/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fake": {
      "types": "./src/adapters/fake.ts",
      "import": "./src/adapters/fake.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run test/contract.spec.ts"
  },
  "dependencies": {
    "@ie/contracts": "workspace:*",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
